#!/usr/bin/bash
set -Eeuo pipefail

readonly PM2_BIN="/usr/bin/pm2"
readonly NODE_BIN="/usr/bin/node"
readonly PM2_RUNTIME="/root/.pm2"
readonly GOODBASE_REPOSITORY="/var/www/GoodBase"
readonly action="${1:-}"

allowed_process() {
  local candidate="$1"
  case "${candidate}" in
    goodads|goodbase-api|goodbase-api-ha|goodbase-worker|goodboost|goodbuilder|\
    goodcustoms|gooddesigner|goodeditor|goodescrow|goodfleet|goodid|goodos|\
    goodqr|goodscan|goodspeech|goodswapz|goodtrusts|goodvoice)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

case "${action}" in
  discover)
    [[ "$#" -eq 1 ]]
    env PM2_HOME="${PM2_RUNTIME}" "${PM2_BIN}" jlist |
      "${NODE_BIN}" -e '
        "use strict";

        let input = "";
        process.stdin.setEncoding("utf8");
        process.stdin.on("data", (chunk) => { input += chunk; });
        process.stdin.on("end", () => {
          const rows = JSON.parse(input || "[]");
          if (!Array.isArray(rows)) throw new Error("PM2 discovery did not return an array.");

          const safeRows = rows.map((row) => {
            const environment = row && row.pm2_env && typeof row.pm2_env === "object"
              ? row.pm2_env
              : {};
            const port = environment.env && typeof environment.env === "object"
              ? environment.env.PORT
              : undefined;

            return {
              name: String(row && row.name || "").slice(0, 160),
              pid: Number.isSafeInteger(row && row.pid) ? row.pid : null,
              pm2_env: {
                status: String(environment.status || "unknown").slice(0, 40),
                pm_cwd: String(environment.pm_cwd || "").slice(0, 1000),
                pm_uptime: Number(environment.pm_uptime) || null,
                restart_time: Number(environment.restart_time) || 0,
                env: {
                  PORT: /^\d{1,5}$/.test(String(port || "")) ? String(port) : null,
                },
              },
            };
          });

          process.stdout.write(`${JSON.stringify(safeRows)}\n`);
        });
      '
    ;;
  restart)
    [[ "$#" -eq 2 ]]
    readonly requested_process="$2"
    allowed_process "${requested_process}"
    if [[ "${requested_process}" == goodbase-* ]]; then
      readonly goodbase_release_commit="$(
        git -c safe.directory="${GOODBASE_REPOSITORY}" \
          -C "${GOODBASE_REPOSITORY}" rev-parse --verify HEAD
      )"
      [[ "${goodbase_release_commit}" =~ ^[0-9a-f]{40}$ ]]
      exec env \
        PM2_HOME="${PM2_RUNTIME}" \
        GOODBASE_RELEASE_COMMIT="${goodbase_release_commit}" \
        "${PM2_BIN}" restart "${requested_process}" --update-env
    fi
    exec env PM2_HOME="${PM2_RUNTIME}" "${PM2_BIN}" restart "${requested_process}" --update-env
    ;;
  save)
    [[ "$#" -eq 1 ]]
    exec env PM2_HOME="${PM2_RUNTIME}" "${PM2_BIN}" save
    ;;
  *)
    echo "Usage: goodos-pm2-control {discover|restart PROCESS|save}" >&2
    exit 64
    ;;
esac
