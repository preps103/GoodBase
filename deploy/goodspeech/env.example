# Store the production copy at /etc/goodbase/goodspeech.env with mode 0640,
# owned by root and readable by the GoodBase runtime group.
# Generate a unique value with: openssl rand -hex 32
KOKORO_TTS_URL=http://127.0.0.1:8880
KOKORO_TTS_TOKEN=replace-with-at-least-32-random-characters
KOKORO_CONCURRENCY=1
GOODSPEECH_REQUIRED=true
# Optional NVIDIA-backed open video worker. Set GOODSPEECH_ENABLE_VIDEO=1 when
# running the provisioner on a host with a supported NVIDIA GPU.
GOODMOTION_VIDEO_URL=
GOODMOTION_VIDEO_TOKEN=
GOODMOTION_JOB_SIGNING_SECRET=
GOODMOTION_RETENTION_SECONDS=86400
# Optional private high-fidelity avatar worker. GoodSpeech remains functional
# with its browser live-avatar renderer when these values are left empty.
GOODAVATAR_LIVE_URL=
GOODAVATAR_LIVE_TOKEN=
